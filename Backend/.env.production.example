APP_ENV=production
DATABASE_ENV=production
DATABASE_URL=postgresql://user:password@your-neon-host/billease_prod?sslmode=require
# Optional Neon pooled runtime URL; migrations always use the direct DATABASE_URL above.
# DATABASE_URL_POOLED=postgresql://user:password@your-neon-pooler-host/billease_prod?sslmode=require
JWT_SECRET=replace-with-a-separate-random-secret-of-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-a-separate-64-random-hex-characters
PORT=3000
# Exact public origin serving the separate Frontend/Admin site (for example https://billease-production.up.railway.app).
ADMIN_WEB_ORIGIN=https://<exact-backend-site-origin>
# Configure only after checking the actual reverse proxy path.
TRUST_PROXY_HOPS=0
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=replace-with-a-separate-production-project-id
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
