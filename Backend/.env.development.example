APP_ENV=development
DATABASE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/billease_dev
# Optional Neon pooled runtime URL; migrations always use DATABASE_URL.
# DATABASE_URL_POOLED=postgresql://user:password@your-neon-pooler-host/billease_dev?sslmode=require
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-64-random-hex-characters
PORT=3000
# Optional for local same-origin development; if set, use the exact admin-site origin.
# ADMIN_WEB_ORIGIN=http://localhost:3000
TRUST_PROXY_HOPS=0
# Owner approval push delivery. Keep false until a Firebase service account is configured.
PUSH_ENABLED=false
# Local development only; use FIREBASE_SERVICE_ACCOUNT_JSON in Railway secrets.
FIREBASE_PROJECT_ID=billease-development
FIREBASE_SERVICE_ACCOUNT_PATH=.secrets/development/firebase-service-account.json
