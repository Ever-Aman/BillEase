# Allow only production runtime sources into the build context.
**
!Dockerfile
!.dockerignore
!Backend/
!Backend/package.json
!Backend/package-lock.json
!Backend/src/
!Backend/src/**
!Backend/migrations/
!Backend/migrations/**
!Backend/assets/
!Backend/assets/**
!Frontend/
!Frontend/Admin/
!Frontend/Admin/index.html
!Frontend/Admin/app.js
!Frontend/Admin/model.mjs
!Frontend/Admin/styles.css
!Frontend/Admin/assets/
!Frontend/Admin/assets/**

# These remain excluded even if they appear inside an allowed runtime tree.
**/.env
**/.env.*
**/*.env
**/*secret*
**/*credential*
**/*service-account*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/.git
**/.git/**
**/.agents
**/.agents/**
**/.codex
**/.codex/**
**/node_modules
**/node_modules/**
**/downloads
**/downloads/**
**/build
**/build/**
**/dist
**/dist/**
**/tmp
**/tmp/**
**/output
**/output/**
